# Copier en .env (non versionné). Lu par decision_core.settings.Settings (pydantic-settings)
# et par le Makefile. En compose, les secrets viennent de infra/secrets/*.txt (Docker secrets) :
# ne mettre ici aucun secret de production.

# --- Application (decision_core.settings.Settings) ---------------------------------------
ENVIRONMENT=dev
REFERENCE_DATE=2026-09-30
# Postgres : chaque composant ne reçoit que le DSN de son rôle (dev : mot de passe = nom du rôle).
APP_DATABASE_URL=postgresql://app_rw:app_rw@localhost:55432/warehouse
OWNER_DATABASE_URL=postgresql://app_owner:app_owner@localhost:55432/warehouse
# Transmis SEULEMENT au sous-processus MCP.
AGENT_RO_DSN=postgresql://agent_ro:agent_ro@localhost:55432/warehouse
# Claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium
LLM_FALLBACKS=false
# Keycloak (OIDC)
KEYCLOAK_ISSUER=https://localhost/auth/realms/decision
# Vide : {KEYCLOAK_ISSUER}/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=
KEYCLOAK_AUDIENCE=decision-api
KEYCLOAK_CLIENT_ID=decision-web
# Clé HMAC de pseudonymisation du sub dans les journaux (obligatoire hors dev)
LOG_PSEUDONYM_KEY=dev-only-change-me
# Vide : dossier semantic/ du dépôt
SEMANTIC_DIR=
MCP_COMMAND=python
MCP_ARGS=-m decision_mcp_server
# Vide : même origine derrière le proxy (jamais « * »)
CORS_ORIGINS=
# API seulement (decision_api.config.ApiSettings) : rapport écrit par make rights-test
RIGHTS_TEST_REPORT=var/rights-test.json

# --- Données et dbt (Makefile, packages/data_gen, warehouse/profiles.yml) -----------------
PG_HOST=localhost
PG_PORT=55432
DBT_PG_HOST=localhost
DBT_PG_PORT=55432
DBT_PG_USER=dbt_owner
DBT_PG_PASSWORD=dbt_owner
DBT_PG_DBNAME=warehouse
DBT_PG_SSLMODE=prefer
# DSN du générateur (rôle dbt_owner)
DBT_OWNER_DSN=postgresql://dbt_owner:dbt_owner@localhost:55432/warehouse
SCALE=1.0
SEED=42
# Test d'intégration du générateur (opt-in, RECRÉE les tables raw de la base visée)
# DATA_GEN_TEST_DSN=postgresql://dbt_owner:dbt_owner@localhost:55432/warehouse

# --- Compose (infra/compose.yaml) ----------------------------------------------------------
PUBLIC_HOST=localhost
WEB_DIST=../web/dist
KC_BOOTSTRAP_ADMIN_USERNAME=admin-temporaire
# Secrets Docker attendus dans infra/secrets/ (créés par `make secrets`, ignorés par git) :
#   postgres_password.txt dbt_owner_password.txt app_owner_password.txt app_rw_password.txt
#   agent_ro_password.txt keycloak_db_password.txt keycloak_admin_password.txt
#   anthropic_api_key.txt log_pseudonym_key.txt
