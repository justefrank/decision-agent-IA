# Copier en .env (non versionné). Lu par decision_core.settings.Settings (pydantic-settings) et par le
# Makefile (`-include .env` puis `export`). En compose, les secrets viennent de infra/secrets/*.txt
# (Docker secrets) : ne mettre ici aucun secret de production.
#
# Règle : ce fichier ne contient que des COMPOSANTS (hôte, port, mots de passe de développement),
# commentés par défaut. Les DSN (APP_DATABASE_URL, OWNER_DATABASE_URL, AGENT_RO_DSN, DBT_OWNER_DSN)
# sont calculés par le Makefile à partir de ces composants : `make seed PG_PORT=55410` ou
# `make init PG_PORT=55410` s'appliquent donc partout, même avec un .env copié de cet exemple.
# Une variable vide exportée par le Makefile masquerait celle de votre shell : décommenter
# seulement ce que l'on renseigne.

# --- Application (decision_core.settings.Settings) ---------------------------------------
ENVIRONMENT=dev
REFERENCE_DATE=2026-09-30
# Clé API Claude (ou l'exporter dans le shell) :
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium
LLM_FALLBACKS=false
# Keycloak (OIDC). JWKS vide : {KEYCLOAK_ISSUER}/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://localhost/auth/realms/decision
# KEYCLOAK_JWKS_URL=
KEYCLOAK_AUDIENCE=decision-api
KEYCLOAK_CLIENT_ID=decision-web
# Preuve d'OTP (claim amr/acr) exigée pour analyste et admin. Défaut : vrai en production seulement.
# REQUIRE_MFA_CLAIM=false
# Clé HMAC de pseudonymisation du sub dans les journaux (démarrage refusé en production si défaut).
LOG_PSEUDONYM_KEY=dev-only-change-me
# SEMANTIC_DIR=            # défaut : dossier semantic/ du dépôt
MCP_COMMAND=python
MCP_ARGS=-m decision_mcp_server
# CORS_ORIGINS=            # défaut : même origine derrière le proxy (jamais « * »)
# RIGHTS_TEST_REPORT=var/reports/rights-test.json   # rapport écrit par make rights-test

# --- Postgres local de développement (Makefile, scripts/dev_pg.sh) ------------------------
# Mot de passe de chaque rôle = son nom (dev seulement). Défauts du Makefile entre parenthèses.
# PG_HOST=localhost        # (localhost)
# PG_PORT=55432            # (55432) ; surchargeable : make init PG_PORT=55410
# PG_DATABASE=warehouse
# APP_RW_PASSWORD=app_rw
# APP_OWNER_PASSWORD=app_owner
# AGENT_RO_PASSWORD=agent_ro
# DBT_PG_USER=dbt_owner
# DBT_PG_PASSWORD=dbt_owner
# DBT_PG_SSLMODE=prefer
# SCALE=1.0
# SEED=42
# Test d'intégration du générateur (opt-in, RECRÉE les tables raw de la base visée)
# DATA_GEN_TEST_DSN=postgresql://dbt_owner:dbt_owner@localhost:55432/warehouse

# --- Compose (infra/compose.yaml) ----------------------------------------------------------
# PUBLIC_HOST=localhost          # nom public (TLS, émetteur Keycloak, redirections du realm)
# PG_PUBLISH_PORT=5432           # port de Postgres compose publié sur 127.0.0.1 (distinct de PG_PORT)
# KC_ADMIN_PORT=8081             # console Keycloak, 127.0.0.1 seulement (tunnel SSH)
# API_ENVIRONMENT=production     # ENVIRONMENT du conteneur API (production par défaut)
# WEB_DIST=../web/dist           # SPA compilée ; absente : page d'attente
# KC_BOOTSTRAP_ADMIN_USERNAME=admin-temporaire
# Secrets Docker attendus dans infra/secrets/ (créés par `make secrets`, ignorés par git) :
#   postgres_password.txt dbt_owner_password.txt app_owner_password.txt app_rw_password.txt
#   agent_ro_password.txt keycloak_db_password.txt keycloak_admin_password.txt
#   anthropic_api_key.txt log_pseudonym_key.txt
