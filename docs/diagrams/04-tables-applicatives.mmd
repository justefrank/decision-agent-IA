erDiagram
  conversation ||--o{ message : contient
  message ||--o{ feedback : "signalée par"
  conversation ||--o{ query_log : trace
  eval_run ||--o{ eval_result : détaille
  conversation {
    uuid id PK
    text user_id "claim sub"
    text title
    timestamptz created_at
  }
  message {
    uuid id PK
    uuid conversation_id FK
    text role "user assistant"
    text content
    jsonb structured_json "AssistantMessage"
    timestamptz created_at
  }
  query_log {
    bigint id PK
    text trace_id
    int step
    int attempt
    text user_ref "HMAC du sub"
    text tool "query_metric run_query describe_schema llm"
    text status "ok error blocked"
    text error_class
    text sql
    int row_count
    bool truncated
    int duration_ms
    text model_served
    text effort
    int tokens_cache_read
    numeric cost_usd
    text semantic_version
  }
  feedback {
    bigint id PK
    uuid message_id FK
    text category
    bool consent_question
    text status "nouveau traite rejete"
    text reject_reason
    bool promoted_to_dev
  }
  eval_run {
    bigint id PK
    text split "test dev intent ..."
    text ablation "none a b c d e"
    text model_id
    text semantic_version
    text git_sha
    int n
    numeric pass1
    numeric pass3
    numeric ci_low
    numeric ci_high
    jsonb report "traçabilité complète"
  }
  eval_result {
    bigint run_id FK
    text question_id
    text category
    int passes "0 a 3"
    jsonb got
  }
  audit_access_log {
    bigint id PK
    text actor_sub
    text actor_role
    text action
    text target_trace_id
  }
  analysis {
    bigint id PK
    date period_start
    date period_end
    text region
    text semantic_version
    jsonb payload "DashboardAnalysis"
  }
